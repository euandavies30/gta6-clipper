# Copy to .env for local runs. On Railway/Render, set these as service variables.
# Never commit .env.

# --- Safety switches -------------------------------------------------------
DRY_RUN=true          # true = log posts only. Flip to false when accounts are connected.
REVIEW_MODE=true      # true = clips wait for approval in the review app

# --- Storage / app ----------------------------------------------------------
DATA_DIR=./data       # on Railway, mount a volume and set DATA_DIR=/data
PUBLIC_BASE_URL=      # e.g. https://gta6-clipper.up.railway.app (needed for IG url uploads, webhooks, TikTok OAuth)
CONTACT_EMAIL=          # shown on /privacy and /terms (use the brand Gmail)
REVIEW_USER=admin
REVIEW_PASSWORD=      # pick a strong one
INGEST_EVERY_HOURS=6
TICK_SECONDS=300
WHISPER_MODEL=base    # tiny/base/small/medium; base fits a 1 GB server

# --- Sources ----------------------------------------------------------------
YOUTUBE_API_KEY=
YTDLP_COOKIES=        # optional: contents of a cookies.txt from a signed-in 18+ YouTube account (age-restricted trailers)

# --- TikTok (one app, shared by both TikTok accounts) -------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY   # PUBLIC_TO_EVERYONE only after TikTok audits the app
TIKTOK_MAIN_REFRESH_TOKEN=    # or connect via /oauth/tiktok/start?account=tt_main
TIKTOK_SECOND_REFRESH_TOKEN=

# --- Instagram ----------------------------------------------------------------
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v21.0
IG_MAIN_USER_ID=
IG_MAIN_ACCESS_TOKEN=
IG_SECOND_USER_ID=
IG_SECOND_ACCESS_TOKEN=

# --- Webhook poster (only if an account uses poster: webhook) -------------------
WEBHOOK_SECRET=
